# Environment configuration template for argument_inferencer
# Copy this file to .env and insert your real credentials:
# cp .env.example .env

# Google Gemini API Key (Alternative: store in OS keyring 'db.syst.datahub')
GOOGLE_API_KEY="your-google-api-key-here"

# Optional: Alternative LLM providers
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional runtime flags
# PYDANTIC_AI_NO_BANNER=1
